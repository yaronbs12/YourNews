DATABASE_URL=postgresql+psycopg2://yournews:yournews@postgres:5432/yournews
APP_ENV=development
APP_NAME=YourNews
APP_BASE_URL=http://127.0.0.1:8000

# Email delivery provider: local or smtp
EMAIL_PROVIDER=local

# SMTP settings (required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-real-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=YourNews
SMTP_USE_TLS=true
